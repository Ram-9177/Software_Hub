# Command Center for Software Hub 2.0 Environment Configuration

# Server & Network
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL 16)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/command_center
DB_CLIENT=pg
# Set USE_IN_MEMORY_DB=true if no local PostgreSQL server is running
USE_IN_MEMORY_DB=true

# Redis (Redis 7)
REDIS_URL=redis://localhost:6379
# Set USE_MOCK_REDIS=true if no local Redis server is running
USE_MOCK_REDIS=true

# RS256 JWT Authentication
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Microsoft OpenID Connect SSO
MS_OIDC_CLIENT_ID=mock-client-id
MS_OIDC_CLIENT_SECRET=mock-client-secret
MS_OIDC_TENANT_ID=common
MS_OIDC_REDIRECT_URI=http://localhost:5000/api/auth/microsoft/callback
ENABLE_MOCK_SSO=true

# Nodemailer SMTP
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=mock_user@ethereal.email
SMTP_PASS=mock_pass
SMTP_FROM="Command Center <notifications@softwarehub2.org>"

# Web-Push (VAPID)
VAPID_PUBLIC_KEY=BDm-example-public-vapid-key
VAPID_PRIVATE_KEY=example-private-vapid-key
VAPID_SUBJECT=mailto:admin@softwarehub2.org

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Google Calendar Integration (OAuth 2.0)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/google/callback

